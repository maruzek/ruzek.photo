{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ruzek-web",
  "compatibility_date": "2026-11-21",
  "d1_databases": [
    {
      // Local only for now; the real database id is added at deployment (plan task 16).
      "binding": "DB",
      "database_name": "ruzek-inquiries",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "db/migrations"
    }
  ],
  // Workers Rate Limiting for POST /api/inquiry, keyed by client IP (the IP is never stored).
  // At most 5 requests per IP per minute (period must be 10 or 60 s).
  "ratelimits": [
    {
      "name": "INQUIRY_RL",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    // Inquiries go here; it is also the Reply-To of the client confirmation.
    "OWNER_EMAIL": "foto@martinruzek.cz",
    // POST /api/inquiry accepts only this Origin. Local runs override it with --var.
    "ALLOWED_ORIGIN": "https://martinruzek.eu"
  }
  // Secrets (wrangler secret put; locally .dev.vars): TURNSTILE_SECRET, RESEND_API_KEY
}
