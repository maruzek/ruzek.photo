# Names of every environment variable of the project, with no real values. Never commit real values.
#
# Two files carry them, both git-ignored:
#   .env       build-time variables and the values for `pnpm check:launch` (read automatically by that script)
#   .dev.vars  Worker secrets for `pnpm preview` / wrangler dev (copy of .dev.vars.example)
# Production secrets are set at Cloudflare with `wrangler secret put <NAME>`; production build variables
# (PUBLIC_*) are set where the production build runs.

# --- Turnstile (spam protection of the inquiry form) ---
# Public site key, baked into the build. Local runs: Cloudflare's public test key below (always passes).
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Secret key (Worker secret). Local runs: Cloudflare's public test secret below (always passes).
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# --- E-mail of the inquiry form (src/server/inquiry/mailer.ts) ---
# Resend API key (Worker secret; the maintenance worker needs it too). Empty = no provider, sending fails.
RESEND_API_KEY=
# `console` sends nothing (local runs and tests). Must NOT be set in production.
MAILER=

# --- Worker ---
# Only this Origin may POST /api/inquiry. Production value is in wrangler.jsonc, local runs override it.
ALLOWED_ORIGIN=http://localhost:8787

# --- Measurement without cookies (src/config/analytics.ts); empty = that tool is off ---
# Absolute https URL of the Umami script, e.g. https://cloud.umami.is/script.js; self-hosted: its own URL
PUBLIC_UMAMI_SRC=
# Website ID from Umami
PUBLIC_UMAMI_WEBSITE_ID=
# Cloudflare Web Analytics beacon token
PUBLIC_CF_BEACON_TOKEN=

# --- Test helpers (not for production) ---
# E2E_PORT=8787   port of the preview that Playwright starts (a second checkout can use another port)
