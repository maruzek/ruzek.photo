---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';

interface Props {
  locale: 'cs' | 'en';
  title: string;
  description: string;
  path: string;
}

// `path` is for the canonical link that SeoHead adds in task 13
const { locale, title, description } = Astro.props;
// Only the two faces above the fold are preloaded (Notch 700 for the name, Text 400 for body copy)
const aboveTheFold = [{ weight: 700, style: 'normal' as const }];
const bodyFace = [{ weight: 400, style: 'normal' as const }];
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      document.documentElement.classList.add(
        matchMedia('(prefers-reduced-motion: reduce)').matches ? 'rm' : 'motion'
      );
    </script>
    <Font cssVariable="--font-notch" preload={aboveTheFold} />
    <Font cssVariable="--font-text" preload={bodyFace} />
    <Font cssVariable="--font-accent" />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
