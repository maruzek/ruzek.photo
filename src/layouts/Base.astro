---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import CopyToast from '../components/CopyToast.astro';
import Loader from '../components/Loader.astro';
import SeoHead from '../components/SeoHead.astro';
import { analytics } from '../config/analytics';
import type { PublishedPhoto } from '../lib/photos/get';
import { alternates, type Locale, type StaticRoute } from '../i18n';

// `route` (and `slug` for a case study) feed canonical and hreflang via alternates() in SeoHead.
// `route: null` is a page without a fixed address (404): no canonical, no hreflang, not indexed.
type Props = {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
  /** Share image source; the hero photo when left out */
  photo?: PublishedPhoto | undefined;
} & (
  | { route: StaticRoute; slug?: never }
  | { route: 'caseStudy'; slug: string }
  | { route: null; slug?: never }
);

const props = Astro.props;
const { locale, title, description, photo } = props;
const paths =
  props.route === null
    ? null
    : props.route === 'caseStudy'
      ? alternates('caseStudy', props.slug)
      : alternates(props.route);
const noindex = props.noindex ?? props.route === null;
// No measurement on a page without a fixed address (404): its path is whatever was typed, an e-mail included (ST-10)
const measure = props.route !== null && Boolean(analytics.umami || analytics.cfBeaconToken);
// Preload the compact files for the name and body copy. Other characters load on demand.
const aboveTheFold = [{ weight: 700, subset: 'core' }];
const bodyFace = [{ weight: 400, subset: 'core' }];
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <SeoHead
      locale={locale}
      title={title}
      description={description}
      paths={paths}
      noindex={noindex}
      photo={photo}
    />
    <script is:inline>
      {
        const root = document.documentElement;
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        root.classList.add(reduced ? 'rm' : 'motion');
        // Entry loader (Loader.astro): only when arriving from another site or with no referrer, never after an
        // internal link, a reload or back/forward, never with reduced motion or Save-Data. Nothing is stored.
        let external = true;
        try {
          external = !document.referrer || new URL(document.referrer).origin !== location.origin;
        } catch {
          // an unreadable referrer counts as an entry from outside
        }
        const nav = performance.getEntriesByType('navigation')[0];
        const fresh = !nav || nav.type === 'navigate';
        if (!reduced && external && fresh && navigator.connection?.saveData !== true) {
          root.classList.add('ldr-on');
          // The curtain goes at once on a key press (Tab must not reach links under it, PageDown must not scroll
          // under it; the key keeps its default action), on a switch to reduced motion, and after 7 s should the
          // loader script never finish. Set up here, so it holds from the first frame until the curtain is gone.
          const end = () => {
            if (!root.classList.contains('ldr-on')) return;
            root.classList.remove('ldr-on');
            document.dispatchEvent(new Event('ldr:exit'));
          };
          setTimeout(end, 7000);
          addEventListener('keydown', end, true);
          matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', end);
        }
        // Safety net (base.css): if the motion layer has not set `motion-ready` after 3 s, show everything. A
        // timer started here counts from navigation. A CSS animation would count from when the stylesheet is
        // applied, and a late stylesheet moved the reveal to 3.9 s. Behind the loader it counts from the hand-over,
        // or a slow hero photo would skip the entrance while the curtain still covers the page.
        const fallback = (delay = 3000) => setTimeout(() => root.classList.add('reveal-fallback'), delay);
        if (root.classList.contains('ldr-on'))
          document.addEventListener('ldr:exit', () => fallback(), { once: true });
        else if (!reduced) fallback(Math.max(0, 3000 - performance.now()));
      }
    </script>
    <Font cssVariable="--font-notch" preload={aboveTheFold} />
    <Font cssVariable="--font-text" preload={bodyFace} />
    <Font cssVariable="--font-accent" />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <Loader />
    <slot />
    {measure && (
      <script
        type="application/json"
        id="analytics-config"
        set:html={JSON.stringify(analytics).replace(/</g, '\\u003c')}
      />
    )}
    <script>
      import '../scripts/loader';
      import '../scripts/motion/boot';
      import '../scripts/analytics-boot';
    </script>
    <CopyToast locale={locale} />
  </body>
</html>
