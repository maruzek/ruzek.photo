---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import type { Locale, StaticRoute } from '../i18n';

// `route` (and `slug` for a case study) feed canonical and hreflang via alternates() in SeoHead (task 13)
type Props = { locale: Locale; title: string; description: string } & (
  | { route: StaticRoute; slug?: never }
  | { route: 'caseStudy'; slug: string }
);

const { locale, title, description } = Astro.props;
// Only the two faces above the fold are preloaded (Notch 700 for the name, Text 400 for body copy)
const aboveTheFold = [{ weight: 700, style: 'normal' as const }];
const bodyFace = [{ weight: 400, style: 'normal' as const }];
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      {
        const root = document.documentElement;
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        root.classList.add(reduced ? 'rm' : 'motion');
        // Safety net (base.css): if the motion layer has not set `motion-ready` after 3 s, show everything. A
        // timer started here counts from navigation. A CSS animation would count from when the stylesheet is
        // applied, and a late stylesheet moved the reveal to 3.9 s.
        if (!reduced) setTimeout(() => root.classList.add('reveal-fallback'), 3000);
      }
    </script>
    <Font cssVariable="--font-notch" preload={aboveTheFold} />
    <Font cssVariable="--font-text" preload={bodyFace} />
    <Font cssVariable="--font-accent" />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/motion/boot';
    </script>
  </body>
</html>
