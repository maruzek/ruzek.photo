---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/base.css';
import SeoHead from '../components/SeoHead.astro';
import { analytics } from '../config/analytics';
import type { PublishedPhoto } from '../lib/photos/get';
import { alternates, type Locale, type StaticRoute } from '../i18n';

// `route` (and `slug` for a case study) feed canonical and hreflang via alternates() in SeoHead.
// `route: null` is a page without a fixed address (404): no canonical, no hreflang, not indexed.
type Props = {
  locale: Locale;
  title: string;
  description: string;
  noindex?: boolean;
  /** Share image source; the hero photo when left out */
  photo?: PublishedPhoto | undefined;
} & (
  | { route: StaticRoute; slug?: never }
  | { route: 'caseStudy'; slug: string }
  | { route: null; slug?: never }
);

const props = Astro.props;
const { locale, title, description, photo } = props;
const paths =
  props.route === null
    ? null
    : props.route === 'caseStudy'
      ? alternates('caseStudy', props.slug)
      : alternates(props.route);
const noindex = props.noindex ?? props.route === null;
// Only the two faces above the fold are preloaded (Notch 700 for the name, Text 400 for body copy)
const aboveTheFold = [{ weight: 700, style: 'normal' as const }];
const bodyFace = [{ weight: 400, style: 'normal' as const }];
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <SeoHead
      locale={locale}
      title={title}
      description={description}
      paths={paths}
      noindex={noindex}
      photo={photo}
    />
    <script is:inline>
      {
        const root = document.documentElement;
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        root.classList.add(reduced ? 'rm' : 'motion');
        // Safety net (base.css): if the motion layer has not set `motion-ready` after 3 s, show everything. A
        // timer started here counts from navigation. A CSS animation would count from when the stylesheet is
        // applied, and a late stylesheet moved the reveal to 3.9 s.
        if (!reduced) setTimeout(() => root.classList.add('reveal-fallback'), 3000);
      }
    </script>
    <Font cssVariable="--font-notch" preload={aboveTheFold} />
    <Font cssVariable="--font-text" preload={bodyFace} />
    <Font cssVariable="--font-accent" />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    {
      (analytics.umami || analytics.cfBeaconToken) && (
        <script type="application/json" id="analytics-config" set:html={JSON.stringify(analytics).replace(/</g, '\\u003c')} />
      )
    }
    <script>
      import '../scripts/motion/boot';
      import '../scripts/analytics-boot';
    </script>
  </body>
</html>
