---
// The inquiry section. The React island (islands/InquiryForm.tsx) renders the side column with the live estimate
// and the form; this component passes it the dictionary and the static parts of the side column as slots.
import '../styles/sections/inquiry.css';
import InquiryForm from '../islands/InquiryForm.tsx';
import { site } from '../config/site';
import { telHref } from '../lib/contact';
import { localePath, t, type Locale } from '../i18n';
import { Call02Icon, Mail01Icon, WhatsappIcon } from '@hugeicons/core-free-icons';
import Icon from './Icon.astro';
import Rich from './Rich.astro';
import Todo from './Todo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const q = d.inquiry;
---

<section class="sec inq" id={d.anchors.inquiry} tabindex="-1" aria-labelledby="inq-h">
  <InquiryForm
    client:visible
    locale={locale}
    siteKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
    text={q}
    addonText={d.services.addons}
    privacyHref={localePath(locale, 'privacy')}
  >
    <Fragment slot="intro">
      <span class="eyebrow mono">{q.eyebrow}</span>
      <h2 class="h" id="inq-h" data-split>
        <Rich text={q.title} />
      </h2>
      <p>{q.lead}</p>
    </Fragment>
    <div slot="direct" class="direct">
      <span class="mono">{q.direct.label}</span>
      <ul>
        <li>
          {site.contact.phone ? (
            <a
              href={telHref(site.contact.phone)}
              data-umami-event="contact_click"
              data-umami-event-type="phone"
            >
              <Icon icon={Call02Icon} />
              <span class="k">{q.direct.call}</span>
              <span class="v">{site.contact.phone}</span>
            </a>
          ) : (
            <Todo>{q.direct.phoneTodo}</Todo>
          )}
        </li>
        {site.contact.whatsapp && (
          <li>
            <a
              href={site.contact.whatsapp}
              rel="noopener"
              target="_blank"
              data-umami-event="contact_click"
              data-umami-event-type="whatsapp"
            >
              <Icon icon={WhatsappIcon} />
              <span class="k">{q.direct.whatsapp}</span>
              <span class="v">{q.direct.whatsappAction}</span>
            </a>
          </li>
        )}
        <li>
          <a
            href={`mailto:${site.contact.email}`}
            data-copy-email
            data-umami-event="contact_click"
            data-umami-event-type="email"
          >
            <Icon icon={Mail01Icon} />
            <span class="k">{q.direct.email}</span>
            <span class="v">{site.contact.email}</span>
          </a>
        </li>
      </ul>
    </div>
  </InquiryForm>
</section>

<script>
  import '../scripts/inquiry-anchor';
</script>
