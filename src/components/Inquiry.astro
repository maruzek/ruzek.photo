---
// The inquiry section. The React island (islands/InquiryForm.tsx) renders the side column with the live estimate
// and the form; this component passes it the dictionary and the static parts of the side column as slots.
import '../styles/sections/inquiry.css';
import InquiryForm from '../islands/InquiryForm.tsx';
import { site } from '../config/site';
import { localePath, t, type Locale } from '../i18n';
import Rich from './Rich.astro';
import Todo from './Todo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const q = d.inquiry;
---

<section class="sec inq" id={d.anchors.inquiry} tabindex="-1" aria-labelledby="inq-h">
  <InquiryForm
    client:visible
    locale={locale}
    siteKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
    text={q}
    addonText={d.services.addons}
    privacyHref={localePath(locale, 'privacy')}
  >
    <Fragment slot="intro">
      <span class="eyebrow mono">{q.eyebrow}</span>
      <h2 class="h" id="inq-h" data-split>
        <Rich text={q.title} />
      </h2>
      <p>{q.lead}</p>
    </Fragment>
    <div slot="direct" class="direct">
      <span class="mono">{q.direct.label}</span>
      <span>
        {q.direct.phone} {site.contact.phone ?? <Todo>{q.direct.phoneTodo}</Todo>}
      </span>
      <span>
        {q.direct.email} <a
          href={`mailto:${site.contact.email}`}
          data-umami-event="contact_click"
          data-umami-event-type="email">{site.contact.email}</a
        >
      </span>
    </div>
  </InquiryForm>
</section>

<script>
  import '../scripts/inquiry-anchor';
</script>
