---
// Goes into the `head` slot of Base. Preloads the AVIF the browser will pick for the hero <img> (LCP).
import type { PublishedPhoto } from '../lib/photos/get';
import { avifSrcset, heroSizes } from '../lib/photos/image';

interface Props {
  photo: PublishedPhoto;
}

const { photo } = Astro.props;
const srcset = await avifSrcset(photo.data.image);
---

<link
  rel="preload"
  as="image"
  type="image/avif"
  imagesrcset={srcset}
  imagesizes={heroSizes(photo.data.image)}
  fetchpriority="high"
/>
