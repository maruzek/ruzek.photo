---
import '../styles/sections/work.css';
import { PLACEMENT } from '../config/placement';
import { t, type Locale } from '../i18n';
import { getPhoto } from '../lib/photos/get';
import Rich from './Rich.astro';
import Shot from './Shot.astro';
import { layoutWork } from '../lib/work-layout';
import '../styles/dither.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

// Slots, rows and roles are in lib/work-layout.ts; the photo at index i of PLACEMENT.work takes slot i, so a
// withdrawn photo leaves the grid and the others keep their slot (its row closes up, no empty cell)
const photos = await Promise.all(PLACEMENT.work.map((id) => getPhoto(id)));
const cells = layoutWork(photos, (p) => p.data.image.height > p.data.image.width);
/** Rendered width: the share of the 12 columns on desktop, full or half width on a phone */
const sizesOf = (cell: (typeof cells)[number]): string => {
  const span = Number(/span (\d+)/.exec(cell.column)?.[1] ?? 12);
  const phone = cell.phoneColumn === '1 / -1' ? '100vw' : '50vw';
  return `(max-width: 900px) ${phone}, ${Math.round((span / 12) * 100)}vw`;
};
---

<section class="sec" id={d.anchors.work} tabindex="-1" aria-labelledby="work-h">
  <div class="sec-head">
    <div>
      <span class="eyebrow mono">{d.work.eyebrow}</span>
      <h2 class="h" id="work-h" data-split>
        <Rich text={d.work.title} />
      </h2>
    </div>
  </div>
  <div class="work">
    {cells.map((cell) => <Shot cell={cell} locale={locale} sizes={sizesOf(cell)} />)}
  </div>
  <div class="work-foot">
    <p>{d.work.foot}</p>
    <a class="lnk" href={`#${d.anchors.inquiry}`}>
      {d.work.footLink}
    </a>
  </div>
</section>
