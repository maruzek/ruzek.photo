---
// Selected work, "three speeds": three lanes of photos that scroll at different rates (motion/work.ts), the
// middle one against the outer two. The layout is plain CSS and complete without the motion layer: the lanes
// stack their photos without gaps, the middle lane starts lower. Below 1100 px the same photos flow into two
// columns, below 641 px into one, in lane order (left, middle, right), which is also the reading, focus and
// lightbox order.
import '../styles/dither.css';
import '../styles/sections/work.css';
import { PLACEMENT, type WorkLane, type WorkShot } from '../config/placement';
import { t, type Locale } from '../i18n';
import { getPhoto } from '../lib/photos/get';
import Rich from './Rich.astro';
import Shot from './Shot.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

/** Rendered frame width per layout (work.css): three lanes, two columns, one column */
const WIDTHS = [
  ['(min-width: 1100px)', 31],
  ['(min-width: 641px)', 47, true],
  [null, 100],
] as const;

const LANES: Record<WorkLane, readonly WorkShot[]> = PLACEMENT.work;
const ORDER: readonly WorkLane[] = ['left', 'middle', 'right'];

// The slot belongs to the photo: a withdrawn photo leaves its lane, the others keep their lane and crop
const lanes = await Promise.all(
  ORDER.map(async (lane) => ({
    lane,
    shots: (
      await Promise.all(
        LANES[lane].map(async (shot) => ({ shot, photo: await getPhoto(shot.id) })),
      )
    ).flatMap(({ shot, photo }) => (photo ? [{ ...shot, photo }] : [])),
  })),
);
// the single dither beat: the first photo of the gallery develops as the section comes in
const lead = lanes.find((l) => l.shots.length > 0)?.shots[0]?.id;
---

<section class="sec" id={d.anchors.work} tabindex="-1" aria-labelledby="work-h">
  <div class="sec-head">
    <div>
      <span class="eyebrow mono">{d.work.eyebrow}</span>
      <h2 class="h" id="work-h" data-split>
        <Rich text={d.work.title} />
      </h2>
    </div>
  </div>
  <div class="work" data-work>
    {
      lanes.map(({ lane, shots }) => (
        <div class:list={['lane', `lane-${lane}`]} data-lane={lane}>
          {shots.map((s) => (
            <Shot
              photo={s.photo}
              locale={locale}
              shot={s}
              widths={WIDTHS}
              dither={s.id === lead}
            />
          ))}
        </div>
      ))
    }
  </div>
  <div class="work-foot">
    <p>{d.work.foot}</p>
    <a class="lnk" href={`#${d.anchors.inquiry}`}>
      {d.work.footLink}
    </a>
  </div>
</section>
