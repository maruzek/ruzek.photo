---
// One frame of the work gallery: a thumbnail left on the contact sheet (cropped to 3:2 when vertical), or a pick
// enlarged in the spread. The link opens the full image without JavaScript; lightbox.ts turns it into the <dialog>.
// `data-full` is the large image, `data-frame` identifies the print, and `data-lb` holds its localized caption.
import { Picture, getImage } from 'astro:assets';
import { t, type Locale } from '../i18n';
import { frameBox, type Frame } from '../lib/photos/contact-sheet';
import type { PublishedPhoto } from '../lib/photos/get';
import { IMAGE_FORMATS, IMAGE_WIDTHS } from '../lib/photos/image';
import PlaceholderTag from './PlaceholderTag.astro';

/** Width of the file the lightbox opens (never larger than the source) */
const FULL_WIDTH = 2000;

interface Props {
  frame: Frame<PublishedPhoto>;
  locale: Locale;
  sizes: string;
}

const { frame, locale, sizes } = Astro.props;
const d = t(locale).work;
const { image, alt, caption, placeholder, category } = frame.photo.data;
const full = await getImage({
  src: image,
  width: Math.min(FULL_WIDTH, image.width),
  format: 'webp',
});
const label = [d.categories[category], caption?.[locale]].filter(Boolean).join(' · ');
// a vertical thumbnail is cropped to the sheet's 3:2 cell; an enlarged pick shows the whole photo
const box = frameBox(image);
---

<a
  class:list={[
    'cs-print',
    frame.slot ? ['cs-pick', frame.slot] : ['cs-thumb', { 'cs-tall': box.vertical }],
  ]}
  href={full.src}
  data-lb={label}
  data-frame={frame.no}
  data-full={full.src}
  data-cursor
  data-placeholder={placeholder ? '' : undefined}
>
  <!-- the picture and its number drift together once a pick has landed (sheet.ts), apart from the fold, which
       moves the link itself -->
  <span class="cs-float">
    <span class="cs-cell">
      <span class="cs-box" style={box.style}>
        <Picture
          src={image}
          alt={alt[locale]}
          widths={IMAGE_WIDTHS}
          formats={IMAGE_FORMATS}
          sizes={sizes}
          loading="lazy"
        />
        {placeholder && <PlaceholderTag locale={locale} />}
      </span>
    </span>
    <span class="cs-no mono" aria-hidden="true">
      {frame.no}
    </span>
  </span>
</a>
