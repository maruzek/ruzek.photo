---
// One service card. Prices and deliverables come from pricing.ts, the words from the dictionary.
import type { Range, Service } from '../config/pricing';
import { fill, t, type Locale } from '../i18n';
import type { PublishedPhoto } from '../lib/photos/get';
import { formatCount, formatRange } from '../lib/pricing/format';
import DitherImage from './DitherImage.astro';
import PlaceholderTag from './PlaceholderTag.astro';
import Rich from './Rich.astro';

interface Props {
  locale: Locale;
  service: Service;
  photo: PublishedPhoto | undefined;
}

const { locale, service, photo } = Astro.props;
const { id, pricing, deliverables } = service;
const d = t(locale);
const text = d.services.cards[id];
const dl = d.services.deliverables;
const { durationMin, perHour, photos, turnaround } = deliverables;
const range = (value: Range): string => formatCount(value, locale);
const parts: string[] = [];
if (durationMin) parts.push(fill(dl.durationMin, { range: range(durationMin) }));
parts.push(fill(perHour ? dl.photosPerHour : dl.photos, { range: range(photos) }));
if (turnaround) {
  parts.push(
    fill(turnaround.unit === 'days' ? dl.turnaroundDays : dl.turnaroundHours, { range: range(turnaround.value) }),
  );
}

const price = formatRange(
  pricing.kind === 'hourly' ? { from: pricing.firstHour, to: pricing.firstHour } : pricing.price,
  locale,
);
---

<article class="svc">
  {photo && (
    <DitherImage
      photo={photo}
      locale={locale}
      sizes="(max-width: 900px) 100vw, 33vw"
      mode="hover"
      cover="light"
    >
      {photo.data.placeholder && <PlaceholderTag locale={locale} />}
    </DitherImage>
  )}
  <h3>
    <Rich text={text.title} />
  </h3>
  <p>{text.text}</p>
  <ul class="dlv">
    <li>
      {/* Keep each part on one line so ranges do not break at the dash. */}
      {parts.map((part, i) => (
        <>
          {i > 0 && ' · '}
          <span class="nw">{part}</span>
        </>
      ))}
    </li>
  </ul>
  <div class="price">
    <span>
      {text.priceLabel}
      {pricing.kind === 'hourly' && 'priceNote' in text && (
        <small>{fill(text.priceNote, { price: formatRange(pricing.nextHour, locale) })}</small>
      )}
    </span>
    <b>{price}</b>
  </div>
  <a
    class="lnk"
    href={`#${d.anchors.inquiry}?${locale === 'cs' ? 'sluzba' : 'service'}=${id}`}
    data-umami-event="estimate_used"
    data-umami-event-service={id}
  >
    {d.services.calcLink}
  </a>
</article>
