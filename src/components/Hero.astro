---
import type { PublishedPhoto } from '../lib/photos/get';
import '../styles/sections/hero.css';
import { MOBILE_PHOTO_POSITION } from '../config/placement';
import { site } from '../config/site';
import { t, type Locale } from '../i18n';
import { heroSizes } from '../lib/photos/image';
import AsciiHero from './AsciiHero.astro';
import Button from './Button.astro';
import PhotoPicture from './PhotoPicture.astro';
import PlaceholderTag from './PlaceholderTag.astro';
import Rich from './Rich.astro';

interface Props {
  locale: Locale;
  photo: PublishedPhoto | undefined;
}

const { locale, photo } = Astro.props;
const mobilePosition = photo && MOBILE_PHOTO_POSITION[photo.id];
const d = t(locale);
const [first = '', ...rest] = site.name.split(' ');
const anchor = (key: keyof typeof d.anchors): string => `#${d.anchors[key]}`;
---

<section class="hero" id="top" tabindex="-1" data-ascii aria-labelledby="name">
  {
    photo && (
      <div class="media" style={mobilePosition && `--mobile-photo-position: ${mobilePosition}`}>
        <PhotoPicture
          image={photo.data.image}
          alt={photo.data.alt[locale]}
          sizes={heroSizes(photo.data.image)}
          mobile={photo.mobile && { image: photo.mobile, sizes: heroSizes(photo.mobile) }}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }
  <AsciiHero />
  {photo && <div class:list={['shade', photo.data.shade === 'strong' && 'strong']} aria-hidden="true" />}
  {photo?.data.placeholder && <PlaceholderTag locale={locale} />}
  <div class="base">
    <h1 id="name">
      <span>{first}</span> <span>{rest.join(' ')}</span>
    </h1>
    <div class="row">
      <p>
        <Rich text={d.hero.lead} />
      </p>
      <div class="cta">
        <Button href={anchor('inquiry')} magnetic>
          {d.hero.cta}
        </Button>
        <a class="lnk" href={anchor('work')}>
          {d.hero.ctaWork}
        </a>
      </div>
    </div>
  </div>
</section>
