---
// Link to the same page in the other language (concept.md, kap. 5).
import { alternates, t, type Locale, type RouteKey } from '../i18n';

interface Props {
  locale: Locale;
  route: RouteKey;
}

const { locale, route } = Astro.props;
const other: Locale = locale === 'cs' ? 'en' : 'cs';
const href = alternates(route)[other];
const d = t(locale).lang;
---

<a href={href} hreflang={other} lang={other} aria-label={d.label} data-umami-event="lang_switch">{d.short}</a>
