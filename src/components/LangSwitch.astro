---
// Link to the same page in the other language (concept.md, kap. 5).
import { alternates, t, type Locale, type StaticRoute } from '../i18n';

/** A case-study page must pass its slug (kept in both languages); other routes take none. */
type Props =
  | { locale: Locale; route: StaticRoute; slug?: never }
  | { locale: Locale; route: 'caseStudy'; slug: string };

const props = Astro.props;
const { locale } = props;
const other: Locale = locale === 'cs' ? 'en' : 'cs';
const href = (props.route === 'caseStudy' ? alternates('caseStudy', props.slug) : alternates(props.route))[other];
const d = t(locale).lang;
---

<a href={href} hreflang={other} lang={other} data-umami-event="lang_switch">{d.other}</a>
