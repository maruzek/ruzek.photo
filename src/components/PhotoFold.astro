---
import type { CollectionEntry } from 'astro:content';
import '../styles/sections/fold.css';
import type { Locale } from '../i18n';
import DitherImage from './DitherImage.astro';
import Rich from './Rich.astro';

interface Props {
  locale: Locale;
  photo: CollectionEntry<'photos'>;
  /** Id of the heading; the section is labelled by it */
  id: string;
  /** Title with `*emphasised*` words */
  title: string;
  chips: readonly string[];
  text: string;
  index: string;
  indexLabel: string;
}

const { locale, photo, id, title, chips, text, index, indexLabel } = Astro.props;
---

<section class="fold" aria-labelledby={id}>
  <DitherImage photo={photo} locale={locale} sizes="100vw" cover="night" />
  <div class:list={['shade', photo.data.shade === 'strong' && 'strong']} aria-hidden="true"></div>
  <div class="note">
    <div>
      <h2 class="h" id={id} data-split>
        <Rich text={title} />
      </h2>
      <ul class="chips">
        {chips.map((chip) => (
          <li>{chip}</li>
        ))}
      </ul>
    </div>
    <p>{text}</p>
    <div class="idx mono" aria-hidden="true">
      <b>{index}</b>
      {indexLabel}
    </div>
  </div>
</section>
