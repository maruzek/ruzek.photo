---
import type { PublishedPhoto } from '../lib/photos/get';
import '../styles/sections/fold.css';
import { MOBILE_PHOTO_POSITION } from '../config/placement';
import type { Locale } from '../i18n';
import DitherImage from './DitherImage.astro';
import PlaceholderTag from './PlaceholderTag.astro';

interface Props {
  locale: Locale;
  /** `undefined` when the photo is withdrawn: the text then sits on the plain night surface */
  photo: PublishedPhoto | undefined;
  /** Id of the heading; the section is labelled by it */
  id: string;
  title: string;
  text: string;
}

const { locale, photo, id, title, text } = Astro.props;
---

<section class="fold" aria-labelledby={id}>
  {photo && (
    <DitherImage
      photo={photo}
      locale={locale}
      sizes="100vw"
      cover="night"
      mobilePosition={MOBILE_PHOTO_POSITION[photo.id]}
    />
  )}
  {photo && (
    <div class:list={['shade', photo.data.shade === 'strong' && 'strong']} aria-hidden="true" />
  )}
  {photo?.data.placeholder && <PlaceholderTag locale={locale} />}
  <div class="note">
    <h2 class="h" id={id} data-split>{title}</h2>
    <p>{text}</p>
  </div>
</section>
