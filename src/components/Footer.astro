---
import '../styles/sections/footer.css';
import { site } from '../config/site';
import { telHref } from '../lib/contact';
import { fill, localePath, t, type Locale } from '../i18n';
import Button from './Button.astro';
import Todo from './Todo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const f = d.footer;
const year = new Date().getFullYear();
const home = localePath(locale, 'home');
const onHome = Astro.url.pathname.replace(/\/?$/, '/') === home;
// first and last name in their own elements, as in the hero: under 900 px each takes a line (footer.css)
const [first = '', ...rest] = site.name.split(' ');
---

<footer class="foot">
  {!onHome && (
    <div class="lead">
      <p>{f.lead}</p>
      <Button href={`${home}#${d.anchors.inquiry}`} magnetic>
        {f.cta}
      </Button>
    </div>
  )}
  <div class="big" aria-hidden="true">
    <span>{first}</span> <span>{rest.join(' ')}</span>
  </div>
  <div class="cols">
    <div>
      <span class="label">{f.shoot.label}</span>
      {f.shoot.value}
    </div>
    <div>
      <span class="label">{f.where.label}</span>
      {f.where.value}
    </div>
    <div>
      <span class="label">{f.instagram.label}</span>
      <a href={site.instagram} rel="me" data-umami-event="contact_click" data-umami-event-type="instagram">
        {site.handle}
      </a>
    </div>
    <div>
      <span class="label">{f.contact.label}</span>
      <a
        href={`mailto:${site.contact.email}`}
        data-copy-email
        data-umami-event="contact_click"
        data-umami-event-type="email">{site.contact.email}</a
      >
      <br />
      {site.contact.phone ? (
        <a
          href={telHref(site.contact.phone)}
          data-umami-event="contact_click"
          data-umami-event-type="phone">{site.contact.phone}</a
        >
      ) : (
        <Todo>{f.contact.phoneTodo}</Todo>
      )}
    </div>
  </div>
  <div class="legal">
    <span>
      {fill(f.legal.copyright, { year, name: site.name })} ·{' '}
      {site.legal.ico ? `${f.legal.ico} ${site.legal.ico}` : <Todo>{f.legal.ico}</Todo>} ·{' '}
      {site.legal.seat ? `${f.legal.seat} ${site.legal.seat}` : <Todo>{f.legal.seat}</Todo>}
    </span>
    <a href={localePath(locale, 'privacy')}>{f.legal.privacy}</a>
  </div>
</footer>
