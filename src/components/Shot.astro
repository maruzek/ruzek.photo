---
// One photo of the work grid. The link opens the full image without JavaScript; lightbox.ts turns it into
// the <dialog> (concept.md §7). `data-full` is the large file the lightbox shows.
import { Picture, getImage } from 'astro:assets';
import type { Locale } from '../i18n';
import { t } from '../i18n';
import type { PublishedPhoto } from '../lib/photos/get';
import { IMAGE_FORMATS, IMAGE_WIDTHS } from '../lib/photos/image';
import PlaceholderTag from './PlaceholderTag.astro';
import Todo from './Todo.astro';

/** Width of the file the lightbox opens (never larger than the source) */
const FULL_WIDTH = 2000;

interface Props {
  photo: PublishedPhoto;
  locale: Locale;
  /** Layout slot of the prototype grid: `w1`–`w8` */
  slot: string;
  sizes: string;
  /** Parallax offset in px for the motion layer */
  par?: number | undefined;
}

const { photo, locale, slot, sizes, par } = Astro.props;
const { image, alt, caption, placeholder } = photo.data;
const full = await getImage({
  src: image,
  width: Math.min(FULL_WIDTH, image.width),
  format: 'webp',
});
const title = caption?.[locale];
---

<a
  class:list={['shot', slot]}
  href={full.src}
  data-lb={title ?? alt[locale]}
  data-full={full.src}
  data-cursor
  data-par={par}
  data-placeholder={placeholder ? '' : undefined}
>
  <span class="frame">
    <Picture
      src={image}
      alt={alt[locale]}
      widths={IMAGE_WIDTHS}
      formats={IMAGE_FORMATS}
      sizes={sizes}
      loading="lazy"
    />
    {placeholder && <PlaceholderTag locale={locale} />}
  </span>
  <span class="cap">
    {title && <b>{title}</b>}
    <Todo>{t(locale).work.captionTodo}</Todo>
  </span>
</a>
