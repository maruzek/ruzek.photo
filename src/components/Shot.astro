---
// One photo of the work gallery. The link opens the full image without JavaScript; lightbox.ts turns it into
// the <dialog> (concept.md §7). `data-full` is the large file the lightbox shows, `data-lb` its caption: the
// category and the place, which the tile itself does not show.
// The frame holds the crop (`aspect-ratio` from SSR, so nothing moves when the image arrives); `.media` is the
// layer the motion layer may shift inside the frame on phones, the image itself only scales on mouse hover.
import { Picture, getImage } from 'astro:assets';
import type { WorkShot } from '../config/placement';
import type { Locale } from '../i18n';
import { t } from '../i18n';
import { COVER } from '../lib/palette';
import type { PublishedPhoto } from '../lib/photos/get';
import { IMAGE_FORMATS, IMAGE_WIDTHS } from '../lib/photos/image';
import PlaceholderTag from './PlaceholderTag.astro';

/** Width of the file the lightbox opens (never larger than the source) */
const FULL_WIDTH = 2000;

interface Props {
  photo: PublishedPhoto;
  locale: Locale;
  /** Crop and focus in the gallery (placement.ts) */
  shot: WorkShot;
  /**
   * Rendered width of the frame per layout, as `sizes` entries without the crop (the component widens them for
   * the crop); `md` marks the two-column layout, which may crop differently
   */
  widths: readonly (readonly [query: string | null, vw: number, md?: boolean])[];
  /** The photo assembles from the Bayer dither as it enters (the gallery's single dither beat) */
  dither?: boolean;
}

const { photo, locale, shot, widths, dither = false } = Astro.props;
const { image, alt, caption, placeholder, category } = photo.data;
const d = t(locale).work;
const full = await getImage({
  src: image,
  width: Math.min(FULL_WIDTH, image.width),
  format: 'webp',
});

// A landscape file in a taller frame is drawn wider than the frame: ask for a file that wide
const overscan = (crop: string): number => {
  const [cw = 1, ch = 1] = crop.split('/').map(Number);
  return Math.max(1, image.width / image.height / (cw / ch));
};
const sizes = widths
  .map(([query, vw, md]) => {
    const crop = (md ? shot.md?.crop : undefined) ?? shot.crop;
    return `${query ? `${query} ` : ''}${Math.ceil(vw * overscan(crop))}vw`;
  })
  .join(', ');
const vars = [
  `--ar: ${shot.crop}`,
  shot.focus && `--focus: ${shot.focus}`,
  shot.md && `--ar-md: ${shot.md.crop}`,
  shot.md?.focus && `--focus-md: ${shot.md.focus}`,
]
  .filter(Boolean)
  .join('; ');
const caps = `${d.category[category]} – ${caption?.[locale] ?? `TODO: ${d.captionTodo}`}`;
---

<a
  class="shot"
  href={full.src}
  data-lb={caps}
  data-full={full.src}
  data-cursor
  data-placeholder={placeholder ? '' : undefined}
>
  <span
    class="frame"
    style={vars}
    data-dz={dither ? 'stay' : undefined}
    data-dz-color={dither ? COVER.light : undefined}
  >
    <span class="media">
      <Picture
        src={image}
        alt={alt[locale]}
        widths={IMAGE_WIDTHS}
        formats={IMAGE_FORMATS}
        sizes={sizes}
        loading="lazy"
      />
    </span>
    {dither && <canvas class="dz" aria-hidden="true" />}
    {placeholder && <PlaceholderTag locale={locale} />}
  </span>
</a>
