---
import '../styles/sections/services.css';
import { PLACEMENT } from '../config/placement';
import { addons, services } from '../config/pricing';
import { t, type Locale } from '../i18n';
import { getPhoto } from '../lib/photos/get';
import Addon from './Addon.astro';
import ServiceCard from './ServiceCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

const photos = await Promise.all(services.map(({ id }) => getPhoto(PLACEMENT.services[id])));
---

<section class="sec svc-sec" id={d.anchors.services} tabindex="-1" aria-labelledby="svc-h">
  <div class="sec-head">
    <h2 class="h" id="svc-h" data-split>{d.services.title}</h2>
    <p data-rise>{d.services.lead}</p>
  </div>
  <div class="services" data-stagger>
    {services.map((service, i) => (
      <ServiceCard locale={locale} service={service} photo={photos[i]} />
    ))}
  </div>
  <div class="addons" data-stagger>
    {addons.map((addon) => (
      <Addon locale={locale} addon={addon} />
    ))}
  </div>
</section>
