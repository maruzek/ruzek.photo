---
// "Selected work" as a contact sheet that opens (prototype 3). Every published frame sits on a dense, numbered
// sheet; the picks (PLACEMENT.work.picks) are enlarged in the spread below, and their seats on the sheet stay
// marked. This server render is the open sheet, which is also the page without JavaScript and with reduced
// motion. The motion layer (scripts/motion/sheet.ts) only adds transforms: it folds each pick back into its seat
// and lets the scroll open the sheet, while a Bayer front develops it (effects/front.ts).
import '../styles/sections/work.css';
import { PLACEMENT } from '../config/placement';
import { t, type Locale } from '../i18n';
import { buildContactSheet, type SpreadSlot } from '../lib/photos/contact-sheet';
import { getPhoto, type PublishedPhoto } from '../lib/photos/get';
import Print from './Print.astro';
import Rich from './Rich.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);

/** Rendered width of each spread slot (work.css: 12 columns on desktop, 2 below 901 px) */
const SPREAD_SIZES: Record<SpreadSlot, string> = {
  s1: '(max-width: 900px) 100vw, 64vw',
  s2: '(max-width: 900px) 50vw, 31vw',
  s3: '(max-width: 900px) 50vw, 23vw',
  s4: '(max-width: 900px) 50vw, 39vw',
  s5: '(max-width: 900px) 50vw, 31vw',
  s6: '(max-width: 900px) 50vw, 31vw',
  s7: '(max-width: 900px) 50vw, 31vw',
  s8: '(max-width: 900px) 100vw, 64vw',
};
/** A thumbnail on the sheet: 4 columns below 901 px, 10 on desktop (work.css) */
const THUMB_SIZES = '(max-width: 900px) 25vw, 11vw';

const ids = PLACEMENT.work.sheet;
const photos = new Map<string, PublishedPhoto | undefined>(
  await Promise.all(ids.map(async (id) => [id, await getPhoto(id)] as const)),
);
const { frames, spread } = buildContactSheet(ids, PLACEMENT.work.picks, (id) => photos.get(id));
---

<section class="sec" id={d.anchors.work} tabindex="-1" aria-labelledby="work-h">
  <div class="sec-head">
    <div>
      <span class="eyebrow mono">{d.work.eyebrow}</span>
      <h2 class="h" id="work-h" data-split>
        <Rich text={d.work.title} />
      </h2>
    </div>
  </div>
  {
    frames.length > 0 && (
      <div class="cs" data-cs>
        <div class="cs-sheet" role="group" aria-label={d.work.sheetLabel}>
          {frames.map((frame) =>
            frame.slot ? (
              // the pick's seat: decorative, the photo itself is the link in the spread
              <span class="cs-seat" data-seat={frame.slot} aria-hidden="true">
                <span class="cs-cell">
                  <span
                    class="cs-box"
                    style={`--ar: ${frame.photo.data.image.width} / ${frame.photo.data.image.height}`}
                  />
                </span>
                <span class="cs-no mono">{frame.no}</span>
              </span>
            ) : (
              <Print frame={frame} locale={locale} sizes={THUMB_SIZES} />
            ),
          )}
          <canvas class="cs-front" aria-hidden="true" />
        </div>
        {spread.length > 0 && (
          <div class="cs-spread">
            {spread.map((frame) => (
              <Print frame={frame} locale={locale} sizes={SPREAD_SIZES[frame.slot]} />
            ))}
          </div>
        )}
      </div>
    )
  }
  <div class="work-foot">
    <p>{d.work.foot}</p>
    <a class="lnk" href={`#${d.anchors.inquiry}`}>
      {d.work.footLink}
    </a>
  </div>
</section>
