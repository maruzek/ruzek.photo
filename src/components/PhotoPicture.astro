---
// A photo as <picture>. With a portrait crop (`mobile`, src/lib/photos/mobile-crop.ts) a phone held upright gets
// the crop and everything else the whole photo; Astro's <Picture> has no art direction, so this renders the same
// markup itself. Without a crop it is Astro's <Picture>.
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import { IMAGE_FORMATS, IMAGE_QUALITY, IMAGE_WIDTHS } from '../lib/photos/image';
import { MOBILE_CROP_MEDIA } from '../lib/photos/mobile-crop';

interface Props {
  image: ImageMetadata;
  alt: string;
  sizes: string;
  /** Portrait crop for phones and its `sizes`; both or neither */
  mobile?: { image: ImageMetadata; sizes: string } | undefined;
  loading: 'eager' | 'lazy';
  fetchpriority?: 'high';
}

const { image, alt, sizes, mobile, loading, fetchpriority } = Astro.props;
const options = { widths: IMAGE_WIDTHS, quality: IMAGE_QUALITY };
const sources = mobile
  ? await Promise.all([
      ...IMAGE_FORMATS.map(async (format) => ({
        media: MOBILE_CROP_MEDIA,
        type: `image/${format}`,
        srcset: (await getImage({ src: mobile.image, format, ...options })).srcSet.attribute,
        sizes: mobile.sizes,
      })),
      ...IMAGE_FORMATS.map(async (format) => ({
        media: undefined,
        type: `image/${format}`,
        srcset: (await getImage({ src: image, format, ...options })).srcSet.attribute,
        sizes,
      })),
    ])
  : [];
const fallback = mobile ? await getImage({ src: image, format: 'jpg', ...options }) : undefined;
---

{
  fallback ? (
    <picture>
      {sources.map((s) => (
        <source media={s.media} type={s.type} srcset={s.srcset} sizes={s.sizes} />
      ))}
      <img
        src={fallback.src}
        srcset={fallback.srcSet.attribute}
        sizes={sizes}
        alt={alt}
        width={image.width}
        height={image.height}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding="async"
      />
    </picture>
  ) : (
    <Picture
      src={image}
      alt={alt}
      widths={IMAGE_WIDTHS}
      formats={IMAGE_FORMATS}
      quality={IMAGE_QUALITY}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
    />
  )
}
