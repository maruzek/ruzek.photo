# Copy to .dev.vars (git-ignored) and fill in. Names only, never commit real values.
# Turnstile secret. This is Cloudflare's PUBLISHED test secret (always passes), not a real secret; it works with the
# test site key 1x00000000000000000000AA in PUBLIC_TURNSTILE_SITE_KEY. Empty would make every local inquiry fail.
# Production uses the real secret via `wrangler secret put TURNSTILE_SECRET` (pnpm check:launch refuses test keys).
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Mail provider (src/server/inquiry/mailer.ts). Leave empty and set MAILER=console for local runs.
RESEND_API_KEY=
MAILER=console
ALLOWED_ORIGIN=http://localhost:8787
